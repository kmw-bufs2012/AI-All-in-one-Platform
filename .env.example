# Venice.ai API 키 (필수)
# venice.ai 계정에서 발급하며, 서버 환경 변수로만 사용됩니다.
VENICE_API_KEY=

# 번역 API (선택) — Azure AI Translator 또는 DeepL 중 하나만 설정하면 됩니다.
# 설정하지 않으면 모델 설명은 원문(영문)만 표시됩니다.

# Azure AI Translator (우선 사용됨)
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=
# AZURE_TRANSLATOR_ENDPOINT=

# DeepL 번역 API (Azure가 없을 때 사용)
# 무료 키는 ":fx" 접미사가 붙습니다.
DEEPL_API_KEY=

# 최초 로그인 계정 생성용 아이디/비밀번호 (선택)
# 설정하지 않으면 첫 계정이 생성되지 않으며 로그인 페이지에서 안내 문구가 표시됩니다.
APP_USERNAME=
APP_PASSWORD=

# 세션 쿠키 서명용 비밀 키 (선택)
# 설정하지 않으면 APP_PASSWORD로 대체됩니다.
SESSION_SECRET=

# SQLite 데이터베이스 파일 경로 (선택)
# 기본값은 ./data/app.db 입니다.
DATABASE_PATH=